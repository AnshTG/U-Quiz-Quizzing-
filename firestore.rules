rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & stats (public read for leaderboard & profile display)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();

      // User quiz history subcollection
      match /quizHistory/{historyId} {
        allow read: if true;
        allow write, delete: if isAuthenticated();
      }

      // User saved quizzes bank (Cloud Vault limit of 50 quizzes)
      match /savedQuizzes/{savedQuizId} {
        allow read: if isAuthenticated();
        allow write, delete: if isAuthenticated();
      }
    }

    // Public shared quizzes
    match /sharedQuizzes/{quizId} {
      // Anyone can read a shared quiz to play it
      allow read: if true;
      
      // Anyone authenticated can create a shared quiz
      allow create: if isAuthenticated()
                    && request.resource.data.id == quizId
                    && request.resource.data.title is string
                    && request.resource.data.questions is list
                    && request.resource.data.config is map;
      
      // Allow updating plays count or creator editing
      allow update: if true;
      // Allow deletion by creator or admin
      allow delete: if isAuthenticated();
    }

    // Attendance records (public read for admin dashboard & leaderboard, create/update if authenticated)
    match /attendance/{recordId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Public community chat messages
    match /publicChat/{messageId} {
      // Anyone can read public study messages in real time
      allow read: if true;
      
      // Authenticated users can send messages with their own uid
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000;

      // Authors or admins can delete/edit messages
      allow update, delete: if isAuthenticated();
    }

    // System configuration (Maintenance mode, announcements, etc.)
    match /system/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}


