rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & stats (public read for leaderboard & profile display)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;

      // User quiz history subcollection
      match /quizHistory/{historyId} {
        allow read: if true;
        allow write, delete: if true;
      }

      // User saved quizzes bank (Cloud Vault limit of 10 quizzes)
      match /savedQuizzes/{savedQuizId} {
        allow read: if true;
        allow write, delete: if true;
      }
    }

    // Collection group matches for Admin queries
    match /{path=**}/quizHistory/{historyId} {
      allow read, write, delete: if true;
    }
    match /{path=**}/savedQuizzes/{savedQuizId} {
      allow read, write, delete: if true;
    }

    // Public shared quizzes
    match /sharedQuizzes/{quizId} {
      // Anyone can read a shared quiz to play it
      allow read: if true;
      
      // Anyone can create or update a shared quiz
      allow create, update: if true;
      
      // Allow deletion by creator or admin
      allow delete: if true;
    }

    // Attendance records (public read for admin dashboard & leaderboard)
    match /attendance/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Top-level Quiz Assessments archive (for admin dashboard direct querying)
    match /quizAssessments/{assessmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Public community chat messages
    match /publicChat/{messageId} {
      // Anyone can read public study messages in real time
      allow read: if true;
      
      // Allow create, update, delete for messages
      allow create, update, delete: if true;
    }

    // Feedback and Bug Reports collection (user reports & admin triage)
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // System configuration (Maintenance mode, announcements, etc.)
    match /system/{configId} {
      allow read: if true;
      allow write, delete: if true;
    }
  }
}


