{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/generate-quiz",
      "destination": "/api/generate-quiz"
    },
    {
      "source": "/ocr",
      "destination": "/api/ocr"
    },
    {
      "source": "/fetch-url",
      "destination": "/api/fetch-url"
    },
    {
      "source": "/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/curriculum",
      "destination": "/curriculum/index.html"
    },
    {
      "source": "/results",
      "destination": "/results/index.html"
    },
    {
      "source": "/guide",
      "destination": "/guide/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
