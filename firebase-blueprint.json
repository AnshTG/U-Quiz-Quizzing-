{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with display information, preferences, and aggregate stats",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "quizzesCompleted": { "type": "number" },
        "totalQuestionsAnswered": { "type": "number" },
        "totalScore": { "type": "number" },
        "preferredClass": { "type": "string" },
        "preferredSyllabusYear": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "QuizHistoryItem": {
      "title": "QuizHistoryItem",
      "description": "Individual quiz attempt record for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "config": {
          "type": "object",
          "properties": {
            "class": { "type": "string" },
            "subject": { "type": "string" },
            "topics": { "type": "array", "items": { "type": "string" } },
            "strength": { "type": "string" },
            "quantity": { "type": "number" },
            "timeLimitMinutes": { "type": "number" },
            "syllabusYear": { "type": "string" }
          },
          "required": ["class", "subject", "topics", "strength", "quantity"]
        },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "questions": { "type": "array" },
        "userAnswers": { "type": "array" },
        "sharedQuizId": { "type": "string" }
      },
      "required": ["id", "userId", "date", "config", "score", "total", "timeSpentSeconds"]
    },
    "SavedQuiz": {
      "title": "SavedQuiz",
      "description": "Custom or pre-saved quiz template stored in user's cloud vault (max 50 limit)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "config": {
          "type": "object",
          "properties": {
            "class": { "type": "string" },
            "subject": { "type": "string" },
            "topics": { "type": "array", "items": { "type": "string" } },
            "strength": { "type": "string" },
            "quantity": { "type": "number" },
            "timeLimitMinutes": { "type": "number" },
            "syllabusYear": { "type": "string" }
          },
          "required": ["class", "subject", "topics", "strength", "quantity"]
        },
        "questions": { "type": "array" },
        "isPreSaved": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "createdAt", "config", "questions"]
    },
    "SharedQuiz": {
      "title": "SharedQuiz",
      "description": "Public shareable quiz that anyone can play with a direct link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorPhoto": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "config": {
          "type": "object",
          "properties": {
            "class": { "type": "string" },
            "subject": { "type": "string" },
            "topics": { "type": "array", "items": { "type": "string" } },
            "strength": { "type": "string" },
            "quantity": { "type": "number" },
            "timeLimitMinutes": { "type": "number" },
            "syllabusYear": { "type": "string" }
          },
          "required": ["class", "subject", "topics", "strength", "quantity"]
        },
        "questions": { "type": "array" },
        "playsCount": { "type": "number" },
        "averageScore": { "type": "number" }
      },
      "required": ["id", "title", "createdAt", "config", "questions"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance check-in record for scholars and admin audit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "timeStr": { "type": "string" },
        "activityType": { "type": "string" },
        "currentStreak": { "type": "number" }
      },
      "required": ["id", "userId", "date", "timestamp"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Public community chat message sent by a student or scholar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string" },
        "subjectTag": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "message", "timestamp"]
    },
    "UserFeedback": {
      "title": "UserFeedback",
      "description": "Bug report or feature feedback submitted by authenticated user for admin triage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhoto": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "timeIST": { "type": "string" },
        "date": { "type": "string" },
        "relatedSubject": { "type": "string" },
        "relatedClass": { "type": "string" },
        "deviceInfo": { "type": "string" },
        "adminNotes": { "type": "string" }
      },
      "required": ["id", "userId", "category", "title", "description", "severity", "status", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/quizHistory/{historyId}": {
      "entity": "QuizHistoryItem",
      "description": "User specific quiz attempt history"
    },
    "/users/{userId}/savedQuizzes/{savedQuizId}": {
      "entity": "SavedQuiz",
      "description": "User custom and pre-saved quizzes stored in cloud vault (max 50 per user)"
    },
    "/sharedQuizzes/{quizId}": {
      "entity": "SharedQuiz",
      "description": "Shareable public quizzes created by users or system"
    },
    "/attendance/{recordId}": {
      "entity": "AttendanceRecord",
      "description": "Global attendance check-ins visible for admin and real-time streaks"
    },
    "/publicChat/{messageId}": {
      "entity": "ChatMessage",
      "description": "Public real-time study discussion room for all students"
    },
    "/feedbacks/{feedbackId}": {
      "entity": "UserFeedback",
      "description": "User submitted bug reports and feedback items visible in admin console"
    }
  }
}
